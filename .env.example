# Puerto del servidor
PORT=3000

# Configuración de WhatsApp Business API
WHATSAPP_API_TOKEN=EAA...YOUR_TOKEN...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=mi_token_verificacion

# Configuración de SQL Server
DB_USER=sa
DB_PASS=YourStrong!Pass
DB_HOST=localhost
DB_NAME=WhatsAppBotDB
DB_PORT=1433

# Configuración de Sesiones
SESSION_SECRET=genera_una_clave_secreta_muy_larga_y_aleatoria
SESSION_TIMEOUT=300000
CONVERSATION_TIMEOUT=1800000

# Configuración de Impresora ESC/POS
PRINTER_ENABLED=false
PRINTER_HOST=192.168.0.100
PRINTER_PORT=9100

# Ambiente
NODE_ENV=development