# ============================================
# CONFIGURACIÓN DE SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# WHATSAPP BUSINESS API
# ============================================
WHATSAPP_API_TOKEN=EAA...YOUR_TOKEN...
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Token para verificar webhook con Meta (REQUERIDO)
# Puede ser cualquier string, pero debe coincidir con Meta Console
WHATSAPP_VERIFY_TOKEN=mi_token_verificacion

# App Secret de Meta para verificación de firma de webhooks (CRÍTICO)
# Obtener desde: Meta App Dashboard > App Settings > Basic > App Secret
# IMPORTANTE: Este es el App Secret REAL de tu Meta App
# Mínimo 32 caracteres requeridos
# NO compartas este secret públicamente
APP_SECRET=your_app_secret_from_meta_dashboard

# ============================================
# BASE DE DATOS SQL SERVER
# ============================================
DB_USER=sa
DB_PASS=YourStrong!Pass
DB_HOST=localhost
DB_NAME=WhatsAppBotDB
DB_PORT=1433

# ============================================
# SEGURIDAD - SESSION SECRET (OBLIGATORIO)
# ============================================
# IMPORTANTE: Genera uno seguro con:
#   npm run generate-secret
# 
# Mínimo 32 caracteres requeridos
# Usa diferentes secrets para desarrollo y producción
# NO uses el ejemplo, genera uno único
SESSION_SECRET=genera_uno_con_npm_run_generate-secret_minimo_32_caracteres

# ============================================
# TIMEOUTS (Milisegundos)
# ============================================
SESSION_TIMEOUT=300000
CONVERSATION_TIMEOUT=1800000

# ============================================
# IMPRESIÓN ESC/POS (Opcional)
# ============================================
PRINTER_ENABLED=false
PRINTER_HOST=192.168.0.100
PRINTER_PORT=9100

# ============================================
# NOTAS IMPORTANTES
# ============================================
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Reemplaza TODOS los valores con tus credenciales reales
# 3. NUNCA commitees el archivo .env al repositorio
# 4. El archivo .env está en .gitignore por seguridad
# 5. Ejecuta 'npm run generate-secret' para generar SESSION_SECRET