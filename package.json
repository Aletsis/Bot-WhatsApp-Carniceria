{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para recibir pedidos de carnicería. Arquitectura: webhook, SQL Server, impresión ESC/POS, sesiones persistentes.",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon --watch src --exec node app.js",
    "dev:client": "cd client && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "init-db": "node scripts/init-db.js",
    "manage-users": "node scripts/manage-users.js",
    "generate-secret": "node scripts/generate-session-secret.js",
    "prod": "set NODE_ENV=production && node app.js",
    "lint": "eslint src/** --fix",
    "format": "prettier --write './src/**/*.js'",
    "logs:test": "node scripts/test-logs.js",
    "logs:stats": "node -e \"import('./src/logger.js').then(m => m.getLogStats().then(s => console.log(JSON.stringify(s, null, 2))))\"",
    "logs:clean": "node -e \"import('./src/logger.js').then(m => m.cleanOldLogs())\"",
    "backup:full": "node scripts/backup-database.js full",
    "backup:diff": "node scripts/backup-database.js diff",
    "backup:stats": "node scripts/backup-database.js stats",
    "backup:clean": "node scripts/backup-database.js clean",
    "backup:test": "node scripts/test-backup.js"
  },
  "lint-staged": {
    "src/**/*.js": [
      "npm run lint",
      "npm run format",
      "git add"
    ]
  },
  "dependencies": {
    "axios": "^1.5.0",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "connect-flash": "^0.1.1",
    "dayjs": "^1.11.9",
    "dotenv": "^17.2.2",
    "escpos": "^3.0.0-alpha.6",
    "escpos-network": "^3.0.0-alpha.5",
    "escpos-usb": "^3.0.0-alpha.4",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "mssql": "^11.0.1",
    "node-cron": "^4.2.1",
    "pino": "^9.11.0",
    "pino-pretty": "^13.1.1",
    "pino-roll": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/postcss": "^4.1.16",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
